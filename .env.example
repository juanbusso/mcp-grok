# Grok MCP - configuration (all optional)

# xAI API key (used when no Grok Build CLI auth is present). Can also be saved via grok_status set_api_key.
XAI_API_KEY=

# Default model for grok_chat / grok_search_x when none is passed and none was saved with set_default_model.
GROK_DEFAULT_MODEL=grok-4.7
# Model sent to the xAI API when the requested model is a Grok Build CLI-only alias (e.g. grok-4.7-build-fast).
GROK_API_MODEL=grok-4.7

# Public URL of the auth portal (auth-portal.mjs), shown in status/error messages.
GROK_PORTAL_URL=http://localhost:8089
GROK_PORTAL_PORT=8089

# Optional: POST {"message": "..."} to this URL when credentials are saved. Disabled when empty.
GROK_NOTIFY_WEBHOOK_URL=

# Default working directory for grok_run_agent.
WORKSPACE_DIR=

# Path overrides (defaults shown in comments)
# GROK_SETTINGS_FILE=~/.gemini/antigravity/grok-mcp-settings.json
# GROK_PROFILE_DIR=~/.gemini/antigravity/grok-browser-profile
# GROK_CLI_BIN=~/.grok/bin/grok
# GROK_CLI_AUTH=~/.grok/auth.json
# MCP_CONFIG_PATH=~/.gemini/config/mcp_config.json
# MCP_SCHEMAS_DIR=~/.gemini/antigravity/mcp
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# GROK_DEVICE_CODE_FILE=<os tmpdir>/grok-device-code.json
